---
import '../styles/global.css';
interface Props { title?: string; description?: string; type?: string; canonicalURL?: string | URL; ogImage?: string; structuredData?: object; }
const {title='Stardew Tips — Practical guides for your next farm decision',description='Independent Stardew Valley guides with crop calendars, machine comparisons, tile layouts, and plans for your next goal.',type='website',canonicalURL,ogImage,structuredData}=Astro.props;
const fullTitle=title.includes('Stardew Tips')?title:`${title} | Stardew Tips`;
const url=canonicalURL??new URL(Astro.url.pathname,Astro.site);
const ogImageUrl=new URL(ogImage??'/og.png',Astro.site);
const path=Astro.url.pathname;
const links=[['/guides/','Guide library'],['/plans/','Make a plan'],['/start-here/','New here?']];
const editorial=path==='/'||path.startsWith('/guides/')||path.startsWith('/categories/')||path==='/start-here/'||path==='/plans/';
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{fullTitle}</title>
<meta name="description" content={description}/><link rel="canonical" href={url}/>
{path==='/404.html'&&<meta name="robots" content="noindex, follow"/>}
<meta name="google-adsense-account" content="ca-pub-5982979765306851"/>
<meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={type}/><meta property="og:url" content={url}/><meta property="og:site_name" content="Stardew Tips"/><meta property="og:image" content={ogImageUrl}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImageUrl}/><link rel="sitemap" href="/sitemap-index.xml"/>
{structuredData&&<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')}/>}
{editorial&&<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5982979765306851" crossorigin="anonymous"/>}
</head><body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header"><div class="header-inner container"><a class="logo" href="/" aria-label="Stardew Tips home"><img src="/favicon.svg" alt="" width="32" height="32"/><span>Stardew<span class="accent">Tips</span><small>A farmer’s field guide</small></span></a><nav aria-label="Main navigation">{links.map(([href,label])=><a href={href} aria-current={path===href||(href==='/guides/'&&path.startsWith('/categories/'))?'page':undefined}>{label}</a>)}<a href="/guides/#guide-search" class="nav-search" aria-label="Search guides">Search <span aria-hidden="true">↗</span></a></nav></div></header>
<main id="main-content"><slot/></main>
<footer class="site-footer"><div class="container footer-grid"><div><a class="foot-brand" href="/">Stardew Tips</a><p>Clear answers for crops, catches, and the next thing you want to try.</p><p class="small">An independent fan guide maintained by <a href="/about/">Holly</a>. For unmodded Stardew Valley 1.6, with patch exceptions noted in each guide.</p></div><div><h2>Find your next step</h2><a href="/start-here/">Start a new farm</a><a href="/plans/">Follow a reading plan</a><a href="/guides/">Search all guides</a></div><div><h2>Behind the guides</h2><a href="/about/">About</a><a href="/editorial-policy/">Sources & corrections</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms & affiliation</a></div></div><div class="container foot-bottom"><span>© {new Date().getFullYear()} Stardew Tips</span><span>Not affiliated with ConcernedApe. Game artwork belongs to its rights holders.</span><a href="#main-content">Back to top ↑</a></div></footer>
</body></html>
