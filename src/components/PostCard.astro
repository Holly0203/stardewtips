---
import type { CollectionEntry } from 'astro:content';
import { categoryMeta } from '../utils/categories';

interface Props {
  guide: CollectionEntry<'guides'>;
  headingLevel?: 'h2' | 'h3';
}

const { guide, headingLevel = 'h3' } = Astro.props;
const cat = categoryMeta(guide.data.category);
const dateStr = guide.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const Tag = headingLevel;
---

<a class={`post-card cat-${cat.slug}`} href={`/guides/${guide.id}/`}>
  <Tag>{guide.data.title}</Tag>
  <p class="desc">{guide.data.description}</p>
  <div class="meta">
    <span class="cat-chip">{cat.name}</span>
    <span>{dateStr}</span>
  </div>
</a>
