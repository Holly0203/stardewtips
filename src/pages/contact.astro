<Base
  title="Contact"
  description="Get in touch with Stardew Tips."
>
	<div class="simple-page container">
		<h1>Contact</h1>
		<p>
			Have a question, a correction, or a guide request? We'd love to hear from
			you.
		</p>
		<p>
			Email us at:
			<a href="mailto:holly125@yeah.net">holly125@yeah.net</a>
		</p>
		<p>
			Include the guide URL, your game version, and the passage to check. We are an
			unofficial fan site and cannot provide official support for Stardew
			Valley.
		</p>
	</div>
</Base>
