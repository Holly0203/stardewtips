---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found"
  description="This page seems to have wandered off the farm. Back to Stardew Tips guides."
>
	<div class="not-found container">
		<div class="nf-icon">
			<img src="/favicon.svg" alt="Stardew Tips sprout logo" width="64" height="64" />
		</div>
		<h1>Lost in the Mines</h1>
		<p>
			This page seems to have wandered off the farm. No ladders here —
			let's head back to town.
		</p>
		<div class="nf-actions">
			<a class="btn" href="/">Back to Home</a>
			<a class="btn btn-secondary" href="/guides/">Browse All Guides</a>
		</div>
	</div>
</Base>
