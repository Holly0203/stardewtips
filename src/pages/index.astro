---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Stardew Tips">
	<section class="hero container">
		<h1>Stardew Valley Guides &amp; Walkthroughs</h1>
		<p>
			In-depth tips and step-by-step guides to help you farm smarter, fish
			better, and master every season in Stardew Valley.
		</p>
	</section>

	<section class="container post-list">
		{
			guides.length === 0 && (
				<p>No guides published yet — check back soon.</p>
			)
		}
		{
			guides.map((guide) => (
				<a class="post-card" href={`/guides/${guide.id}/`}>
					<h2>{guide.data.title}</h2>
					<p class="desc">{guide.data.description}</p>
					<div class="meta">
						<span>
							{guide.data.pubDate.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</span>
						{guide.data.tags.map((tag) => <span class="tag">{tag}</span>)}
					</div>
				</a>
			))
		}
	</section>
</Base>
