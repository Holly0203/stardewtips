---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES } from '../utils/categories';
const guides = await getCollection('guides', ({data}) => !data.draft);
const featured = ['spring-crop-guide','fishing-guide-beginners','community-center-guide','sprinkler-guide','mining-guide-beginners','energy-management-tips'].map(id => guides.find(g => g.id === id)).filter(Boolean);
---
<Base title="Stardew Tips — A little guidance. A better farm." description="Practical Stardew Valley guides for your first week, seasonal crops, fishing, mining, and Community Center bundles. Find your next step on the farm.">
  <section class="home-hero container">
    <div class="hero-copy"><p class="eyebrow">THE INDEPENDENT FARMER’S FIELD GUIDE</p><h1>A little guidance.<br/><em>A better farm.</em></h1><p class="hero-description">Your next harvest. Your first big catch. That last elusive bundle. Find a clear plan for whatever comes next in Stardew Valley.</p><div class="hero-actions"><a class="btn" href="/start-here/">Find your first steps <span aria-hidden="true">↗</span></a><a class="text-link" href="/guides/">Explore all {guides.length} guides →</a></div><p class="hero-caption">For new farmers and fresh saves · Unmodded Stardew Valley 1.6</p></div>
    <div class="field-note"><div class="note-top"><span>FROM THE FIELD</span><span>NO. 01 / SPRING</span></div><div class="crop-display" aria-hidden="true"><img src="/images/items/parsnip.png" width="96" height="96"/><img src="/images/items/strawberry.png" width="96" height="96"/><img src="/images/items/cauliflower.png" width="96" height="96"/></div><span class="eyebrow">A SMALL START GOES A LONG WAY</span><h2>Your first week,<br/>one day at a time.</h2><p>Start small, make room for fishing, and save for your next planting. You don’t have to do everything on day one.</p><a class="text-link" href="/guides/first-week-guide/">Read the day-by-day plan →</a><div class="note-bottom">15 seeds. A watering can. A new beginning.</div></div>
  </section>
  <div class="intro-strip"><div class="container"><span>Less searching. More farming.</span><span>{guides.length} in-depth guides</span><a href="/editorial-policy/">How we write & correct our guides ↗</a></div></div>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">MAKE YOURSELF AT HOME</p><h2>What are you working on?</h2></div><a class="text-link" href="/guides/">The whole bookshelf →</a></div><div class="topic-grid">{CATEGORIES.map((c,i)=><a class="topic-card" href={`/categories/${c.slug}/`}><span class="topic-number">0{i+1}</span><img src={c.icon} alt="" width="48" height="48"/><h3>{c.name}</h3><p>{c.blurb}</p><span class="topic-bottom">{guides.filter(g=>g.data.category===c.name).length} guides <span aria-hidden="true">↗</span></span></a>)}</div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">KEEP THESE CLOSE</p><h2>A few good places to begin.</h2></div><span class="muted">Practical answers for everyday farm decisions</span></div><div class="card-grid">{featured.map(guide=><PostCard guide={guide!}/>)}</div></section>
  <section class="season-panel container"><div><p class="eyebrow">PLAN AHEAD, GROW AT YOUR OWN PACE</p><h2>Every season has its own rhythm.</h2><p>Choose crops before you buy seeds. Keep an eye on the calendar, leave room for bundles, and give yourself a little breathing space.</p></div><div class="season-links">{[['Spring','spring-crop-guide','The first fresh start'],['Summer','summer-crop-guide','Make room for regrowth'],['Fall','fall-crop-guide','One more big harvest'],['Winter','winter-guide','Build for what comes next']].map(([name,id,desc])=><a href={`/guides/${id}/`}><strong>{name}</strong><span>{desc}</span><b aria-hidden="true">↗</b></a>)}</div></section>
  <section class="closing-note container"><p class="eyebrow">A NOTE FROM STARDEW TIPS</p><h2>There’s no perfect way to play.</h2><p>These guides explain the choices so you can make your own. Take the scenic route, miss a harvest, make friends. The farm will still be there tomorrow.</p><a class="text-link" href="/about/">About this little corner of the valley →</a></section>
</Base>
