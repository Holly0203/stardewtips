---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
import PostCard from '../components/PostCard.astro';
import {CATEGORIES} from '../utils/categories';
import {PLANS} from '../data/plans';
const guides=await getCollection('guides',({data})=>!data.draft);
const selected=['first-week-guide','keg-vs-preserves-jar','greenhouse-guide','fishing-guide-beginners','community-center-guide','skull-cavern-guide'].map(id=>guides.find(g=>g.id===id)!);
---
<Base title="Stardew Tips — Know your next step on the farm" description="Find practical Stardew Valley answers, crop calendars, measured layouts, and six reading plans for a new farm or your next big goal.">
<section class="home-hero container"><div><p class="eyebrow">THE INDEPENDENT FARMER’S FIELD GUIDE</p><h1>A good day starts<br/>with a <em>small plan.</em></h1><p class="hero-description">What to plant. What to keep. Where to go next. Practical Stardew Valley guides for the decision in front of you.</p><form class="search-form" action="/guides/" role="search"><label for="home-search" class="sr-only">Search guides</label><input id="home-search" name="q" type="search" placeholder="Try greenhouse, coal, or fishing…"/><button type="submit">Find a guide <span aria-hidden="true">→</span></button></form><div class="hero-caption"><span>{guides.length} focused guides</span><span>Unmodded 1.6</span><a href="/editorial-policy/">Sources & corrections ↗</a></div></div><aside class="question-board"><div class="board-top"><span>WHAT’S ON YOUR MIND?</span><img src="/images/items/parsnip.png" alt="" width="40" height="40"/></div>{[['01','I just started a farm','/start-here/','A Spring 1–7 reading route'],['02','My crops take all morning','/plans/#farm-systems','Layouts, watering, and collection'],['03','Which machine earns more?','/guides/keg-vs-preserves-jar/','Added value, time, and materials'],['04','I’m ready for somewhere new','/plans/#island','Boat repairs to the Forge']].map(([n,title,href,desc])=><a href={href}><span>{n}</span><div><strong>{title}</strong><small>{desc}</small></div><b aria-hidden="true">↗</b></a>)}</aside></section>
<section class="category-strip container" aria-label="Browse guide categories">{CATEGORIES.map(c=><a href={`/categories/${c.slug}/`}><img src={c.icon} alt="" width="24" height="24"/>{c.name}<span>{guides.filter(g=>g.data.category===c.name).length}</span></a>)}</section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">ONE GOAL AT A TIME</p><h2>Choose a direction.</h2></div><a class="text-link" href="/plans/">All six reading plans →</a></div><div class="plan-grid">{PLANS.slice(0,3).map((p,i)=><a class="plan-preview" href={`/plans/#${p.id}`}><span class="eyebrow">0{i+1} / {p.label}</span><h3>{p.title}</h3><p>{p.outcome}</p><span class="text-link">{p.steps.length} steps to follow ↗</span></a>)}</div></section>
<section class="season-panel container"><div><p class="eyebrow">BEFORE YOU BUY THE SEEDS</p><h2>Plant for the days<br/>you actually have.</h2><p>Compare growing time, seed cost, and the next harvest date. Save the bundle crop before selling the rest.</p></div><div class="season-links">{[['Spring','spring-crop-guide','Parsnips, Potatoes & Strawberries'],['Summer','summer-crop-guide','Blueberries, Melons & Starfruit'],['Fall','fall-crop-guide','Cranberries, Pumpkins & Rare Seeds'],['Winter','winter-guide','Feed, upgrades & next Spring']].map(([season,id,text])=><a href={`/guides/${id}/`}><strong>{season}</strong><span>{text}</span><b aria-hidden="true">↗</b></a>)}</div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">USEFUL AT MORE THAN ONE STAGE</p><h2>Keep these within reach.</h2></div><a class="text-link" href="/guides/">Browse the full library →</a></div><div class="card-grid">{selected.map(guide=><PostCard guide={guide}/>)}</div></section>
<section class="field-feature container"><a href="/guides/farm-layout-tips/" class="field-image"><img src="/images/guides/quality-sprinkler-walking-layout.svg" alt="A measured field with four sprinklers, thirty-two plants, and a walking aisle" width="560" height="386" loading="lazy"/></a><div><p class="eyebrow">COUNT THE TILES, THEN PLANT</p><h2>A layout you can<br/>actually walk through.</h2><p>Four Quality Sprinklers. Thirty-two crop positions. A clear aisle. Start with one working block before copying it across the farm.</p><a class="text-link" href="/guides/farm-layout-tips/">Open the tile-by-tile plan →</a></div></section>
</Base>
