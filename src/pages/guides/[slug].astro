---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categorySlug, categoryMeta } from '../../utils/categories';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
  );
  return guides.map((guide, i) => {
    const prev = i > 0 ? guides[i - 1] : null;
    const next = i < guides.length - 1 ? guides[i + 1] : null;
    return { params: { slug: guide.id }, props: { guide, prev, next } };
  });
}

const { guide, prev, next } = Astro.props;
const { Content, headings } = await render(guide);
const cat = categoryMeta(guide.data.category);
const minutes = await readingTime(guide);
const dateStr = guide.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedStr = guide.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const url = new URL(`/guides/${guide.id}/`, Astro.site);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    datePublished: guide.data.pubDate.toISOString().slice(0, 10),
    dateModified: (guide.data.updatedDate ?? guide.data.pubDate).toISOString().slice(0, 10),
    author: { '@type': 'Person', name: 'Holly', url: 'https://stardewtips.com/about/' },
    publisher: { '@type': 'Organization', name: 'Stardew Tips' },
    mainEntityOfPage: url.toString(),
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://stardewtips.com/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://stardewtips.com/guides/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: cat.name,
        item: `https://stardewtips.com/categories/${cat.slug}/`,
      },
      { '@type': 'ListItem', position: 4, name: guide.data.title, item: url.toString() },
    ],
  },
];
---

<Base
  title={guide.data.title}
  description={guide.data.description}
  type="article"
  canonicalURL={url}
  structuredData={structuredData}
>
	<nav class="breadcrumbs container" aria-label="Breadcrumb">
		<a href="/">Home</a> ›
		<a href="/guides/">Guides</a> ›
		<a href={`/categories/${cat.slug}/`}>{cat.name}</a> ›
		<span>{guide.data.title}</span>
	</nav>

	<div class="article-layout container">
		{headings.length > 2 && (
			<aside class="article-toc" aria-label="Table of contents">
				<div class="toc-title">On this page</div>
				<ul>
					{headings.map((h) => (
						<li class={`depth-${h.depth}`}>
							<a href={`#${h.slug}`}>{h.text}</a>
						</li>
					))}
				</ul>
			</aside>
		)
		}
		<article class={`article cat-${cat.slug}`}>
			<header class="article-header">
				<h1>{guide.data.title}</h1>
				<p class="desc">{guide.data.description}</p>
				<div class="article-meta">
					<span class="cat-chip">{cat.name}</span>
					<span>{dateStr}</span>
					{updatedStr && updatedStr !== dateStr && <span>Updated {updatedStr}</span>}
					<span>{minutes} min read</span>
                    <a href="/about/">By Holly · Stardew Tips</a>
				</div>
			</header>
			<p class="article-scope">Guide scope: unmodded Stardew Valley 1.6. Settings, platforms, and mods may change results. <a href="/editorial-policy/">Sources & corrections</a></p>
			<div class="prose">
				<Content />
			</div>

			{(prev || next) && (
				<nav class="post-nav" aria-label="More guides">
					{prev && (
						<a href={`/guides/${prev.id}/`}>
							<span class="pn-label">← Previous guide</span>
							{prev.data.title}
						</a>
					)}
					{next && (
						<a class="next" href={`/guides/${next.id}/`}>
							<span class="pn-label">Next guide →</span>
							{next.data.title}
						</a>
					)}
				</nav>
			)
			}

		</article>
	</div>
</Base>
