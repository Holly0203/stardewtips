---
import {getCollection,render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import {categoryMeta} from '../../utils/categories';
import {readingTime} from '../../utils/readingTime';
import index from '../../data/guideIndex.json';
import {PLANS} from '../../data/plans';
export async function getStaticPaths(){const guides=await getCollection('guides',({data})=>!data.draft);return guides.map(guide=>({params:{slug:guide.id},props:{guide,guides}}));}
const {guide,guides}=Astro.props;
const {Content,headings}=await render(guide);
const toc=headings.filter(h=>h.depth===2);const cat=categoryMeta(guide.data.category);
const entry=index[guide.id as keyof typeof index];const minutes=await readingTime(guide);
const matchingPlan=PLANS.find(p=>p.steps.some(s=>s[0]===guide.id));
const related=entry.related.map(id=>guides.find(g=>g.id===id)!);
const date=(d:Date)=>d.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});
const url=new URL(`/guides/${guide.id}/`,Astro.site);
const correction=`mailto:holly125@yeah.net?subject=${encodeURIComponent('Guide correction: '+guide.data.title)}&body=${encodeURIComponent(url+'\nGame version / platform:\nPassage to check:\nReference or explanation:\n')}`;
const structuredData=[{'@context':'https://schema.org','@type':'Article',headline:guide.data.title,description:guide.data.description,datePublished:guide.data.pubDate.toISOString().slice(0,10),dateModified:(guide.data.updatedDate??guide.data.pubDate).toISOString().slice(0,10),author:{'@type':'Person',name:'Holly',url:'https://stardewtips.com/about/'},publisher:{'@type':'Organization',name:'Stardew Tips'},mainEntityOfPage:url.toString(),inLanguage:'en'},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://stardewtips.com/'},{'@type':'ListItem',position:2,name:cat.name,item:`https://stardewtips.com/categories/${cat.slug}/`},{'@type':'ListItem',position:3,name:guide.data.title,item:url.toString()}]}];
---
<Base title={guide.data.title} description={guide.data.description} type="article" canonicalURL={url} structuredData={structuredData}>
<div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"/></div>
<nav class="breadcrumbs container" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/categories/${cat.slug}/`}>{cat.name}</a><span aria-hidden="true">/</span><span>{entry.topic}</span></nav>
<div class="article-layout container"><aside class="article-sidebar"><a class="back-link" href={`/guides/?topic=${encodeURIComponent(entry.topic)}`}>← {entry.topic}</a><nav class="article-toc" aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p><ol>{toc.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>{matchingPlan&&<a class="sidebar-plan" href={`/plans/#${matchingPlan.id}`}><span class="eyebrow">PART OF A PLAN</span><strong>{matchingPlan.title}</strong><span>See the reading order →</span></a>}</aside>
<article class="article"><header class="article-header"><div class="article-labels"><a href={`/categories/${cat.slug}/`}>{cat.name}</a><span>{entry.stage}</span></div><h1>{guide.data.title}</h1><p class="desc">{guide.data.description}</p><div class="article-meta"><a href="/about/">By Holly</a><span>{minutes} min read</span><span>Published {date(guide.data.pubDate)}</span>{guide.data.updatedDate&&<span>Updated {date(guide.data.updatedDate)}</span>}</div></header>
<div class="article-scope"><span>Stardew Valley 1.6 · Unmodded</span><a href="/editorial-policy/">Scope & sources ↗</a></div>
{toc.length>0&&<details class="mobile-contents"><summary>On this page</summary><nav aria-label="Article contents"><ol>{toc.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details>}
<div class="prose"><Content/></div><div class="article-feedback"><div><strong>Something doesn’t match your game?</strong><p>Include the passage, game version, and platform so we can check it.</p></div><a href={correction}>Report a correction ↗</a></div>
</article></div><section class="section container related-section"><div class="section-heading"><div><p class="eyebrow">KEEP THE SAME GOAL IN VIEW</p><h2>Continue from here.</h2></div><a class="text-link" href="/guides/">Back to the library →</a></div><div class="card-grid">{related.map(g=><PostCard guide={g}/>)}</div></section>
</Base>
<script>
const bar=document.querySelector<HTMLElement>('#reading-progress-bar');
const article=document.querySelector<HTMLElement>('.prose');
let pending=false;
function update(){if(bar&&article){const rect=article.getBoundingClientRect();const total=Math.max(1,article.offsetHeight-window.innerHeight);bar.style.width=`${Math.min(100,Math.max(0,-rect.top/total*100))}%`;}pending=false;}
window.addEventListener('scroll',()=>{if(!pending){pending=true;requestAnimationFrame(update);}},{passive:true});window.addEventListener('resize',update);update();
const links=[...document.querySelectorAll<HTMLAnchorElement>('.article-toc a')];
if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{for(const e of entries){if(e.isIntersecting){for(const a of links){const current=a.hash==='#'+e.target.id;a.classList.toggle('current',current);if(current)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');}}}},{rootMargin:'-10% 0px -65% 0px'});document.querySelectorAll('.prose h2').forEach(h=>observer.observe(h));}
document.querySelectorAll<HTMLTableElement>('.prose table').forEach(table=>{table.tabIndex=0;table.setAttribute('aria-label','Data table; scroll horizontally for more columns');});
</script>
