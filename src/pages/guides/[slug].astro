---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const dateStr = guide.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={guide.data.title}
  description={guide.data.description}
  type="article"
  canonicalURL={new URL(`/guides/${guide.id}/`, Astro.site)}
>
	<article class="article container">
		<header class="article-header">
			<h1>{guide.data.title}</h1>
			<p class="desc">{guide.data.description}</p>
			<div class="article-meta">
				<span>{dateStr}</span>
				<span>{guide.data.category}</span>
			</div>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</Base>
