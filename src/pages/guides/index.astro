---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import {CATEGORIES} from '../../utils/categories';
import index from '../../data/guideIndex.json';
const guides=(await getCollection('guides',({data})=>!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const topics=[...new Set(Object.values(index).map(x=>x.topic))].sort();
---
<Base title="Guide Library: Search by Topic and Farm Stage" description="Search all Stardew Tips guides by crop, machine, fish, or goal. Filter by category, topic, and the stage of your farm.">
<section class="page-intro container"><p class="eyebrow">THE GUIDE LIBRARY</p><h1>Find the answer<br/>you came for.</h1><p class="lede">{guides.length} focused guides. Search a name or choose the part of the farm you want to work on.</p></section>
<section class="library container" aria-label="Search and browse guides"><form class="library-controls" role="search" id="library-form"><div class="search-field"><label for="guide-search">Search the library</label><input class="guide-search" id="guide-search" name="q" type="search" placeholder="Crop, machine, fish, or goal…" autocomplete="off"/></div><div class="filter-row"><label>Category<select id="category-filter" name="category"><option value="">All categories</option>{CATEGORIES.map(c=><option value={c.slug}>{c.name}</option>)}</select></label><label>Topic<select id="topic-filter" name="topic"><option value="">All topics</option>{topics.map(t=><option value={t}>{t}</option>)}</select></label><label>Farm stage<select id="stage-filter" name="stage"><option value="">Any stage</option>{['Starting out','Building the farm','Later game'].map(s=><option value={s}>{s}</option>)}</select></label><button type="reset" class="reset-button">Clear filters</button></div></form><div class="library-status"><p id="search-status" role="status" aria-live="polite">Showing all {guides.length} guides</p><a href="/plans/">Prefer a reading order? Follow a plan →</a></div><p class="empty-state" id="empty-results" hidden>No guides match those filters. Try fewer words or <button type="button" id="clear-empty">clear the filters</button>.</p><noscript><p>All guides are listed below. Use your browser’s Find command to search without JavaScript.</p></noscript><div class="card-grid library-grid">{guides.map(guide=><PostCard guide={guide} headingLevel="h2"/>)}</div></section>
</Base>
<script>
const form=document.querySelector<HTMLFormElement>('#library-form');
const search=document.querySelector<HTMLInputElement>('#guide-search')!;
const category=document.querySelector<HTMLSelectElement>('#category-filter')!;
const topic=document.querySelector<HTMLSelectElement>('#topic-filter')!;
const stage=document.querySelector<HTMLSelectElement>('#stage-filter')!;
const cards=[...document.querySelectorAll<HTMLElement>('.library-grid .post-card')];
const normalize=(s:string)=>s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'');
const params=new URLSearchParams(location.search);
for(const el of [search,category,topic,stage]){const value=params.get(el.name);if(value!==null&&(el instanceof HTMLInputElement||[...el.options].some(o=>o.value===value)))el.value=value;}
function update(){
 const words=normalize(search.value.trim()).split(/\s+/).filter(Boolean);let count=0;
 for(const card of cards){const d=card.dataset;const match=(!category.value||d.category===category.value)&&(!topic.value||d.topic===topic.value)&&(!stage.value||d.stage===stage.value)&&words.every(w=>normalize(d.search??'').includes(w));card.hidden=!match;if(match)count++;}
 document.querySelector('#search-status')!.textContent=`Showing ${count} of ${cards.length} guides`;
 document.querySelector<HTMLElement>('#empty-results')!.hidden=count>0;
 const next=new URLSearchParams();for(const el of [search,category,topic,stage])if(el.value.trim())next.set(el.name,el.value.trim());
 history.replaceState(null,'',`${location.pathname}${next.size?'?'+next.toString():''}${location.hash}`);
}
form?.addEventListener('submit',e=>{e.preventDefault();update();});
form?.addEventListener('input',update);form?.addEventListener('change',update);
form?.addEventListener('reset',()=>setTimeout(update,0));
document.querySelector('#clear-empty')?.addEventListener('click',()=>{form?.reset();search.focus();});
update();
</script>
