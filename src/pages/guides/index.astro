---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, categorySlug } from '../../utils/categories';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const byCategory = CATEGORIES.map((c) => ({
  ...c,
  posts: guides.filter((g) => categorySlug(g.data.category) === c.slug),
})).filter((c) => c.posts.length > 0);
---

<Base
  title="All Guides"
  description="Every Stardew Valley guide on Stardew Tips, grouped by category — getting started, farming, fishing, mining, and community."
  canonicalURL={new URL('/guides/', Astro.site)}
>
	<section class="hero container">
		<h1>All Guides</h1>
		<p class="lede">{guides.length} guides covering every season of your farm. Choose a topic below or search for a crop, skill, or goal.</p>
	<label class="search-label" for="guide-search">Find a guide</label><input class="guide-search" id="guide-search" type="search" placeholder="Try crops, fishing, gifts…"/><p id="search-status" role="status" aria-live="polite"></p></section>

	{byCategory.map((c) => (
		<section class="section container">
			<h2 class="section-title">
				<a href={`/categories/${c.slug}/`}>{c.name}</a>
			</h2>
			<div class="card-grid">
				{c.posts.map((guide) => <PostCard guide={guide} />)}
			</div>
		</section>
	))}
</Base>

<script>
const input = document.querySelector<HTMLInputElement>('#guide-search');
input?.addEventListener('input', () => {
 const query = input.value.trim().toLowerCase();
 let count = 0;
 document.querySelectorAll<HTMLAnchorElement>('.post-card').forEach(card => { card.hidden = !card.textContent?.toLowerCase().includes(query); if (!card.hidden) count++; });
 document.querySelectorAll<HTMLElement>('main > .section').forEach(section => { section.hidden = !section.querySelector('.post-card:not([hidden])'); });
 const status = document.querySelector('#search-status');
 if (status) status.textContent = query ? `${count} guide${count === 1 ? '' : 's'} found.${count ? '' : ' Try a broader term, such as farming or fishing.'}` : '';
});
</script>
